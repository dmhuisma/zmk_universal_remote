#include <dt-bindings/zmk/matrix_transform.h>
#include "universal_remote_physical_layout.dtsi"

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        status = "disabled";
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <4>;

        // Top to bottom: the D-pad (SW1; SW8, SW5, SW9; SW4), then the
        // pairs SW6/SW7, SW2/SW3 and SW10/SW11.
        map = <
                    RC(0,0)
            RC(3,1) RC(0,1) RC(0,2)
                    RC(3,0)
            RC(1,1)         RC(2,1)
            RC(1,0)         RC(2,0)
            RC(1,2)         RC(2,2)
        >;
    };
};

#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <dt-bindings/dt-lvgl/dt-lvgl.h>
#include "universal_remote.dtsi"
#include "universal_remote_ui.dtsi"

/ {
    chosen {
        zephyr,display = &st7789v;
        zmk,backlight = &backlight;
    };

    // Waveshare 1.9" Touch LCD: ST7789V2, 170x320 panel at column offset 35.
    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi3>;
        dc-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789v: st7789v@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            // SPIM3 maximum. Lower it (16 MHz, 8 MHz) if the image shows corruption.
            mipi-max-frequency = <32000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            width = <170>;
            height = <320>;
            x-offset = <35>;
            y-offset = <0>;
            porch-param = [0c 0c 00 33 33];
            gctrl = <0x35>;
            vcom = <0x28>;
            lcm = <0x0c>;
            vrhs = <0x10>;
            vdvs = <0x20>;
            pwctrl1-param = [a4 a1];
            pvgam-param = [d0 00 02 07 0a 28 32 44 42 06 0e 12 14 17];
            nvgam-param = [d0 00 02 07 0a 28 31 54 47 0e 1c 17 1b 1e];
            // BGR panel, no rotation.
            mdac = <0x08>;
            colmod = <0x55>;
            gamma = <0x01>;
            ram-param = [00 f8];
            rgb-param = [cd 08 14];
            cmd2en-param = [5a 69 02 01];
        };
    };

    lvgl_pointer {
        compatible = "zephyr,lvgl-pointer-input";
        input = <&cst816>;
    };

    backlight: pwmleds {
        compatible = "pwm-leds";

        // Active-low backlight enable, driven at 1 kHz.
        display_backlight: display_backlight {
            pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
        };
    };

    zephyr,user {
        // MPU6050 INT
        imu-int-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        // IR receiver supply, on only while learning (src/ir_rx_enable.c)
        ir-power-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
    };

    // IR LEDs
    ir_pwm: ir_pwm {
        compatible = "pwm-leds";

        ir_pwm_led: ir_pwm_led {
            pwms = <&pwm1 0 PWM_NSEC(26316) PWM_POLARITY_NORMAL>;
        };
    };

    aliases {
        irpwm = &ir_pwm_led;
    };

    behaviors {
        ir_tx: ir_tx {
            compatible = "zmk,behavior-ir-tx";
            #binding-cells = <2>;
        };
    };

    // TSOP38238, active low. zmk-ir wants the raw level, so ACTIVE_HIGH.
    ir_rx: ir_rx {
        compatible = "zmk,ir-rx";
        in-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
    };
};

// Diodes point from rows to columns, so the rows drive and the columns read.
&kscan0 {
    diode-direction = "row2col";
    wakeup-source;
    row-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>,  // SW1, SW5, SW9
                <&gpio1 11 GPIO_ACTIVE_HIGH>, // SW2, SW6, SW10
                <&gpio1 6 GPIO_ACTIVE_HIGH>,  // SW3, SW7, SW11
                <&gpio0 9 GPIO_ACTIVE_HIGH>;  // SW4, SW8
    col-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // D1-D4
                <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, // D5-D8
                <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // D9-D11
    status = "okay";
};

// P0.09 and P0.10 are NFC pins by default.
&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    // SPIM3 is the only nRF52840 SPI master above 8 MHz. Its 32 MHz clock needs high-drive outputs.
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 6)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 6)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };

    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
            nordic,invert;
        };
    };
    // VCC is off while asleep, so driving the pin high would power the
    // display through it. src/sleep.c makes ZMK suspend the PWM only after
    // it cuts VCC, so the pin still holds the backlight off until then.
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
            low-power-enable;
        };
    };

    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 24)>;
        };
    };
    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 24)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    cst816: cst816@15 {
        compatible = "hynitron,cst816s";
        reg = <0x15>;
        irq-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
        rst-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};
